# ============================================
# 国家地理标识特产商城 - 环境变量配置模板
# ============================================

# -------- 服务器配置 --------
# 服务端口
PORT=3000

# 环境 (development | production | test)
NODE_ENV=development

# 前端URL（用于CORS配置）
CLIENT_URL=http://localhost:5173


# -------- 数据库配置 --------
# PostgreSQL 连接字符串
DATABASE_URL=postgresql://username:password@localhost:5432/chinageo_mall

# Redis 连接
REDIS_URL=redis://localhost:6379


# -------- JWT 认证配置 --------
# JWT 密钥（生产环境请使用强随机字符串）
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT 过期时间
JWT_EXPIRES_IN=7d

# Refresh Token 过期时间
REFRESH_TOKEN_EXPIRES_IN=30d


# -------- 微信登录配置 --------
# 微信开放平台 AppID
WECHAT_APP_ID=your-wechat-app-id

# 微信开放平台 AppSecret
WECHAT_APP_SECRET=your-wechat-app-secret


# -------- 微信支付配置 --------
# 微信支付商户号
WECHAT_MCH_ID=your-wechat-merchant-id

# 微信支付 APIv3 密钥
WECHAT_API_V3_KEY=your-wechat-api-v3-key

# 微信支付商户私钥路径
WECHAT_PRIVATE_KEY_PATH=./certs/wechat_private_key.pem

# 微信支付平台证书路径
WECHAT_CERTIFICATE_PATH=./certs/wechat_certificate.pem


# -------- 支付宝配置 --------
# 支付宝应用ID
ALIPAY_APP_ID=your-alipay-app-id

# 支付宝商户私钥
ALIPAY_PRIVATE_KEY=your-alipay-private-key

# 支付宝支付宝公钥
ALIPAY_PUBLIC_KEY=your-alipay-public-key

# 支付宝网关（生产环境使用正式网关）
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do


# -------- 文件存储配置（阿里云OSS）--------
# OSS AccessKey
OSS_ACCESS_KEY_ID=your-oss-access-key-id

# OSS AccessKey Secret
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret

# OSS 存储空间名称
OSS_BUCKET=chinageo-mall

# OSS 访问域名
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# OSS CDN 域名（公开访问）
OSS_CDN_DOMAIN=https://cdn.chinageo-mall.com


# -------- SMS 服务配置（阿里云短信）--------
# 短信 AccessKey
SMS_ACCESS_KEY_ID=your-sms-access-key-id

# 短信 AccessKey Secret
SMS_ACCESS_KEY_SECRET=your-sms-access-key-secret

# 短信签名
SMS_SIGN_NAME=国家地理标识特产商城

# 短信模板CODE
SMS_TEMPLATE_CODE=SMS_123456789


# -------- 邮件服务配置（QQ邮箱）--------
# 邮箱地址
EMAIL_HOST=smtp.qq.com

# 邮箱端口
EMAIL_PORT=465

# 邮箱账号
EMAIL_USER=your-email@qq.com

# 邮箱授权码（不是登录密码）
EMAIL_PASS=your-email-authorization-code


# -------- 日志配置 --------
# 日志级别 (error | warn | info | debug)
LOG_LEVEL=info

# 日志文件路径
LOG_FILE_PATH=./logs


# -------- 限流配置 --------
# 接口限流（请求数/分钟）
RATE_LIMIT_MAX=100


# -------- 地理位置服务 --------
# 高德地图 API Key（用于地理标识产品产地展示）
AMAP_API_KEY=your-amap-api-key
